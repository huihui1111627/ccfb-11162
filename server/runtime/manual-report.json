{
  "month": "2026-08",
  "steps": [
    {
      "title": "步骤1 合并范围判定（控制权基础）",
      "detail": "纳入 14 家：P、A1、A2、B1、C1、B2、B3、B4、C2、C3、D2、D3、E1、D1。\n· A1 华源华东科技有限公司：有效持股 80.00%，纳入合并\n· A2 华南智造有限公司：有效持股 45.00%，持股未过半但协议实质控制，纳入合并\n· B1 华源香港贸易有限公司：有效持股 100.00%，纳入合并\n· C1 华源欧洲装备 GmbH：有效持股 70.00%，纳入合并\n· F1 北方能源合营有限公司：不具控制权（联营），不纳入\n· B2 苏州精密部件有限公司：有效持股 72.00%，纳入合并\n· B3 杭州软件服务有限公司：有效持股 48.00%，持股未过半但协议实质控制，纳入合并\n· B4 华源越南制造有限公司：有效持股 60.00%，纳入合并\n· C2 佛山模具科技有限公司：有效持股 36.00%，持股未过半但协议实质控制，纳入合并\n· C3 东莞表面处理有限公司：有效持股 24.75%，持股未过半但协议实质控制，纳入合并\n· D2 华源新加坡商贸 Pte Ltd：有效持股 100.00%，纳入合并\n· D3 华源德国销售 GmbH：有效持股 80.00%，纳入合并\n· E1 常州新材料有限公司：有效持股 50.40%，纳入合并\n· D1 西北材料有限公司：有效持股 19.20%，持股未过半但协议实质控制，纳入合并"
    },
    {
      "title": "步骤2 外币报表折算（期末汇率/平均汇率）",
      "detail": "资产负债按期末汇率、收入费用按平均汇率、实收资本/资本公积按历史汇率折算，折算差额轧差计入\"外币报表折算差额\"。本月折算差额合计 -10005.08 元（CNY 主体为 0，USD/EUR 主体产生）。"
    },
    {
      "title": "步骤3 汇总个别报表数",
      "detail": "将 14 家纳入主体折算后的 CNY 报表逐行加总，得到合并底稿\"个别数\"栏。"
    },
    {
      "title": "步骤4a 内部应收应付抵消",
      "detail": "双方金额折 CNY 后按较小者（核对一致部分）抵消，借 内部应付 / 贷 内部应收，本月抵消 182650.59 元；未抵消差额合计 6128.45 元保留挂账并在核对页标注原因（在途/汇率/漏记/金额差异）。"
    },
    {
      "title": "步骤4b 内部销售收入与采购抵消",
      "detail": "按核对一致金额抵消，借 内部销售收入 / 贷 营业成本，本月抵消 754962.23 元，双方差额列示原因不强行抵消。"
    },
    {
      "title": "步骤5 未实现内部利润抵消（按存货留存比例）",
      "detail": "对期末仍留存于买方的内部购入存货，按内含毛利抵消未实现利润，借 营业成本 / 贷 存货，本月 14145.89 元；逆流交易形成的部分按少数股东比例分摊。"
    },
    {
      "title": "步骤6 长期股权投资与子公司权益抵消",
      "detail": "借 子公司收购日实收资本/资本公积/留存收益 + 商誉（5340.00 元），贷 长期股权投资（合并成本）、贷 少数股东权益（收购日份额）；收购后净资产增量再按 NCI 比例重分类至少数股东权益。"
    },
    {
      "title": "步骤7 少数股东损益",
      "detail": "逐户按 子公司折算后净利润 × 少数股东比例 计算，逆流交易未实现利润按 NCI 比例冲减，本月少数股东损益合计 323021.06 元，单列于利润表。"
    },
    {
      "title": "步骤8 利润表抵消事项结转留存收益",
      "detail": "内部销售抵消对净利润净影响为 0（收入与成本同额对冲）；未实现利润抵消使净利润减少 14145.89 元，借 留存收益，保证资产负债表配平。"
    }
  ],
